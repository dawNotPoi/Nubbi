{
  "compilerOptions": {
    // NodeNext 让 TypeScript 按 Node.js ESM 规则解析源码中的 .js 导入路径。
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Assistant Runtime 涉及模型与工具参数，保持严格类型可以尽早发现协议错误。
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // NestJS 的 Controller、Module 和依赖注入都依赖装饰器能力。
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist"
  },
  "include": ["src"]
}
