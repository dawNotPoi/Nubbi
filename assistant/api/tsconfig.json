{
  "compilerOptions": {
    // NodeNext 让 TypeScript 按 Node.js ESM 规则解析模块。
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 由 tsx 直接运行 TypeScript 源码；tsc 仅检查类型，并允许导入路径使用 .ts 扩展名。
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Assistant Runtime 涉及模型与工具参数，保持严格类型可以尽早发现协议错误。
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // NestJS 的 Controller、Module 和依赖注入都依赖装饰器能力。
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "dist"
  },
  "include": ["src"]
}
