PORT=8787

# 可选：本地未设置或设为 development 时输出日志源码位置；生产部署设置 production。
NODE_ENV=development

# 必填：复制 server/.env 的 MONGO_URI 或填写其他 MongoDB 连接；留空会拒绝启动。
MONGO_URI=
ASSISTANT_MONGO_DB_NAME=NubbiAssistant

# 设置管理密钥。手机端配置模型、ChatGPT 登录或 MCP 时需要输入。
CONFIG_ADMIN_TOKEN=dawnot

# 可选：MCP 配置中的 ${NUBBI_MCP_TOKEN} 会从这里读取。
NUBBI_MCP_TOKEN=

# 可选：无法从 PATH 找到 Codex CLI 时，填写 codex.js 或可执行文件的绝对路径。
CODEX_CLI_PATH=
