# 忽略所有 Node 依赖文件夹
node_modules

# 忽略所有 Node 模块的 lock 文件 (可选，但推荐)
package-lock.json
npm-debug.log

# 忽略环境配置文件
.env
.env.local
turn/certs/*
!turn/certs/.gitkeep

server/storage
.pnpm-store/

# 忽略本地运行日志，避免提交输出或密钥
.run-logs/
.claude/worktrees/

/data/codex/



.tmp/

# 构建产物兜底：各子项目另有专属 ignore，这里防止根目录或废弃目录下的产物被提交
dist/
.next/
*.tsbuildinfo

# Agent 工作区临时产物
.superpowers/
