# 忽略所有 Node 依赖文件夹
/node_modules

# 忽略所有 Node 模块的 lock 文件 (可选，但推荐)
package-lock.json
npm-debug.log

# 忽略环境配置文件
.env
.env.local

server/storage
.pnpm-store/

# 忽略本地运行日志，避免提交输出或密钥
.run-logs/
.claude/worktrees/

# Assistant 运行时配置、数据与构建产物
assistant/config/mcp.json
assistant/config/model.json
assistant/config/skills.json
assistant/data/*.json
assistant/data/*.jsonl
assistant/data/codex/
/data/codex/
assistant/mobile/.expo/
assistant/mobile/dist/
assistant/api/dist/
assistant/web/dist/
assistant/api/node_modules/
assistant/web/node_modules/
assistant/mobile/node_modules/
assistant/**/*.tsbuildinfo



.tmp/
