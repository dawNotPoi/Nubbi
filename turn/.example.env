# 使用 pnpm turn:init 生成 turn/.env，不要把本模板直接用于公网。
TURN_MODE=local
TURN_EXTERNAL_IP=
TURN_REALM=
TURN_TLS_ENABLED=false
# 本地仅允许显式指定的测试主机，生产保持为空。
TURN_ALLOWED_PEER_IP=
MEETING_STUN_URLS=
MEETING_TURN_URLS=
# 必须是随机生成的 64 位十六进制字符串，后端与 coturn 共用。
MEETING_TURN_SECRET=
# 每个临时用户名、全服务的分配数量上限。
TURN_USER_QUOTA=12
TURN_TOTAL_QUOTA=120
# 单位为字节/秒，入站与出站分别计算；按服务器实际带宽调整。
TURN_MAX_BPS=1048576
TURN_BPS_CAPACITY=12500000
