{
  "name": "nubbi-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Model Context Protocol server for safely operating Nubbi notes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nubbi-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:stdio": "node dist/transport/stdio.js",
    "start:http": "node dist/transport/http.js",
    "dev": "tsx watch src/index.ts",
    "dev:stdio": "tsx src/transport/stdio.ts",
    "dev:http": "tsx src/transport/http.ts",
    "test": "node scripts/run-tests.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
