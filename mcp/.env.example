NUBBI_API_URL=http://localhost:4000
NUBBI_API_KEY=nb_replace_with_a_scoped_mcp_token
MCP_TRANSPORT=stdio

# Streamable HTTP only
MCP_HOST=0.0.0.0
MCP_PORT=3100
# Host 白名单（逗号分隔）。留空表示不校验 Host 头（默认公开）；
# 需要限制来源时填写，例如：MCP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp.example.com
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=https://app.example.com
